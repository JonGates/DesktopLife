<Window x:Class="DesktopLife.App.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Icon="/DesktopLife;component/Assets/DesktopLife.ico" Title="{DynamicResource Title}" Width="620" Height="800" MinWidth="470" MinHeight="480"
    WindowStartupLocation="CenterScreen" Background="#F0F4F1" Foreground="#243C33"
    FontFamily="Microsoft YaHei UI" FontSize="12" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/DesktopLife.Rendering;component/Themes/SettingsTheme.xaml"/>
        </ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </Window.Resources>
    <DockPanel>
        <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="22,0,22,18">
            <Border DockPanel.Dock="Top" BorderBrush="#D5E0D9" BorderThickness="0,1,0,0" Margin="0,0,0,10" Padding="0,10,0,0">
                <TextBlock x:Name="Status" Text="{DynamicResource Hint}" TextWrapping="Wrap" Foreground="#65776F" FontSize="11" MinHeight="30" AutomationProperties.LiveSetting="Polite"/>
            </Border>
            <Button x:Name="PauseButton" Content="{DynamicResource Pause}" Click="PauseClicked" DockPanel.Dock="Left"/>
            <Button x:Name="ApplyButton" Content="{DynamicResource Apply}" Click="ApplyClicked" IsDefault="True" DockPanel.Dock="Right" Background="#306951" Foreground="White" BorderBrush="#306951"/>
        </DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="22,16,22,12">
                <DockPanel LastChildFill="True" Margin="0,0,0,12">
                    <ComboBox x:Name="LanguagePicker" DockPanel.Dock="Right" Width="108" Height="30" VerticalAlignment="Center" SelectionChanged="LanguageChanged" AutomationProperties.Name="{DynamicResource Language}"><ComboBoxItem Content="简体中文" Tag="zh-CN"/><ComboBoxItem Content="English" Tag="en-US"/></ComboBox>
                    <StackPanel><TextBlock Text="DesktopLife" FontFamily="Segoe UI Semibold" FontSize="25"/><TextBlock Text="{DynamicResource SettingsTagline}" Foreground="#65776F" Margin="0,3,12,0"/></StackPanel>
                </DockPanel>
                <TabControl x:Name="SettingsPages" SelectionChanged="SettingsPageChanged" AutomationProperties.Name="{DynamicResource SettingsNavigation}">
                    <TabItem x:Name="CreaturesPage" Header="{DynamicResource CreaturesPageTitle}"><StackPanel TextElement.Foreground="#243C33">
                        <TextBlock Text="{DynamicResource SceneIntro}" Style="{StaticResource Description}" Margin="0,0,0,12"/>
        <TabControl x:Name="HabitatTabs" SelectionChanged="HabitatChanged" Background="Transparent" BorderThickness="0" Padding="0,12,0,0" AutomationProperties.Name="{DynamicResource HabitatLabel}">

            <TabItem x:Name="ForestTab" Header="{DynamicResource Forest}" Foreground="#306951" Background="#E6EEE9"><StackPanel TextElement.FontWeight="Normal">
        <Border Background="White" BorderBrush="#D5E0D9" BorderThickness="1" CornerRadius="12" Padding="14">
            <StackPanel>
                <TextBlock Text="{DynamicResource Fly}" FontWeight="SemiBold"/>
                <TextBlock Text="{DynamicResource FlyHelp}" FontSize="12" TextWrapping="Wrap" Foreground="#63776C" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
        <Border Background="White" BorderBrush="#D5E0D9" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,8,0,0">
            <Expander x:Name="AdditionalSpeciesExpander" Header="{DynamicResource AdditionalSpecies}" IsExpanded="True">
                <StackPanel>
                    <TextBlock Text="{DynamicResource AdditionalHelp}" TextWrapping="Wrap" Foreground="#63776C" Margin="0,6,0,10"/>
                    <Grid Margin="0,3,0,3">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="66"/><ColumnDefinition Width="66"/><ColumnDefinition Width="66"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="{DynamicResource CountColumn}" HorizontalAlignment="Center" Foreground="#63776C"/>
                        <TextBlock Grid.Column="2" Text="{DynamicResource MinColumn}" HorizontalAlignment="Center" Foreground="#63776C"/>
                        <TextBlock Grid.Column="3" Text="{DynamicResource MaxColumn}" HorizontalAlignment="Center" Foreground="#63776C"/>
                    </Grid>
                    <Grid Margin="0,3,0,3">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="66"/><ColumnDefinition Width="66"/><ColumnDefinition Width="66"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Roach}" ToolTip="{DynamicResource RoachHelp}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,6,0"/>
                        <TextBox x:Name="RoachCount" Grid.Column="1" MaxLength="3" FontSize="13" MinHeight="29" Margin="4,0,0,0" AutomationProperties.Name="{DynamicResource RoachCountName}"/>
                        <TextBox x:Name="RoachMin" Grid.Column="2" MaxLength="3" FontSize="13" MinHeight="29" Margin="4,0,0,0" AutomationProperties.Name="{DynamicResource MinSize}"/>
                        <TextBox x:Name="RoachMax" Grid.Column="3" MaxLength="3" FontSize="13" MinHeight="29" Margin="4,0,0,0" AutomationProperties.Name="{DynamicResource MaxSize}"/>
                    </Grid>
                    <Grid Margin="0,3,0,3">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="66"/><ColumnDefinition Width="66"/><ColumnDefinition Width="66"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Ant}" ToolTip="{DynamicResource AntHelp}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,6,0"/>
                        <TextBox x:Name="AntCount" Grid.Column="1" MaxLength="3" FontSize="13" MinHeight="29" Margin="4,0,0,0" AutomationProperties.Name="{DynamicResource AntCountName}"/>
                        <TextBox x:Name="AntMin" Grid.Column="2" MaxLength="3" FontSize="13" MinHeight="29" Margin="4,0,0,0" AutomationProperties.Name="{DynamicResource MinSize}"/>
                        <TextBox x:Name="AntMax" Grid.Column="3" MaxLength="3" FontSize="13" MinHeight="29" Margin="4,0,0,0" AutomationProperties.Name="{DynamicResource MaxSize}"/>
                    </Grid>
                    <Grid Margin="0,3,0,3">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="66"/><ColumnDefinition Width="66"/><ColumnDefinition Width="66"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Caterpillar}" ToolTip="{DynamicResource CaterpillarHelp}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,6,0"/>
                        <TextBox x:Name="CaterpillarCount" Grid.Column="1" MaxLength="3" FontSize="13" MinHeight="29" Margin="4,0,0,0" AutomationProperties.Name="{DynamicResource CaterpillarCountName}"/>
                        <TextBox x:Name="CaterpillarMin" Grid.Column="2" MaxLength="3" FontSize="13" MinHeight="29" Margin="4,0,0,0" AutomationProperties.Name="{DynamicResource MinSize}"/>
                        <TextBox x:Name="CaterpillarMax" Grid.Column="3" MaxLength="3" FontSize="13" MinHeight="29" Margin="4,0,0,0" AutomationProperties.Name="{DynamicResource MaxSize}"/>
                    </Grid>
                    <StackPanel x:Name="AdditionalSpeciesPanel"/>
                </StackPanel>
            </Expander>
        </Border>
            </StackPanel></TabItem>
            <TabItem x:Name="OceanTab" Header="{DynamicResource Ocean}" Foreground="#1C647D" Background="#E1F0F6"><StackPanel TextElement.FontWeight="Normal">
                <Border Background="#EAF5FA" BorderBrush="#BEDCE8" BorderThickness="1" CornerRadius="12" Padding="14">
                    <StackPanel><TextBlock Text="{DynamicResource Turtle}" FontWeight="SemiBold" Foreground="#1C647D"/><TextBlock Text="{DynamicResource TurtleHelp}" TextWrapping="Wrap" Foreground="#526F80" Margin="0,4,0,0"/></StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#BEDCE8" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,8,0,0">
                    <Expander x:Name="OceanSpeciesExpander" Header="{DynamicResource OceanSpecies}" IsExpanded="True"><StackPanel>
                        <TextBlock Text="{DynamicResource OceanHelp}" TextWrapping="Wrap" Foreground="#526F80" Margin="0,6,0,10"/>
                        <Grid Margin="0,3,0,3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="66"/><ColumnDefinition Width="66"/><ColumnDefinition Width="66"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="{DynamicResource CountColumn}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{DynamicResource MinColumn}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{DynamicResource MaxColumn}" HorizontalAlignment="Center"/>
                        </Grid>
                        <StackPanel x:Name="OceanSpeciesPanel"/>
                    </StackPanel></Expander>
                </Border>
            </StackPanel></TabItem>
            <TabItem Header="{DynamicResource Rain}" Foreground="#42657D" Background="#E2ECF4">
                <Border Style="{StaticResource Card}"><StackPanel>
                    <TextBlock Text="{DynamicResource RainTitle}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{DynamicResource RainHelp}" Style="{StaticResource Description}"/>
                </StackPanel></Border>
            </TabItem>
        </TabControl>
                        <TextBlock Text="{DynamicResource HabitatHelp}" Style="{StaticResource Description}" FontSize="11" Margin="0,12,0,0"/>
                    </StackPanel></TabItem>
                    <TabItem x:Name="SaverPage" Header="{DynamicResource SaverPageTitle}"><StackPanel TextElement.Foreground="#243C33">
                        <TextBlock Text="{DynamicResource SaverHeading}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{DynamicResource SaverIntro}" Style="{StaticResource Description}" Margin="0,0,0,16"/>
                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock Text="{DynamicResource SaverPreviewTitle}" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="{DynamicResource SaverPreviewHelp}" Style="{StaticResource Description}" Margin="0,6,0,12"/>
                            <Button x:Name="SaverPreviewButton" Content="{DynamicResource SaverPreview}" Click="SaverPreviewClicked" HorizontalAlignment="Left" Background="#306951" Foreground="White" BorderBrush="#306951"/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource Card}" Margin="0,10,0,0"><StackPanel>
                            <TextBlock Text="{DynamicResource SaverContentTitle}" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="{DynamicResource SaverContentHelp}" Style="{StaticResource Description}" Margin="0,6,0,12"/>
                            <Button x:Name="SaverContentButton" Content="{DynamicResource SaverContent}" Click="SaverContentClicked" HorizontalAlignment="Left"/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource Card}" Margin="0,10,0,0"><StackPanel>
                            <TextBlock Text="{DynamicResource SaverWindowsTitle}" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="{DynamicResource SaverWindowsHelp}" Style="{StaticResource Description}" Margin="0,6,0,12"/>
                            <Button x:Name="SaverWindowsButton" Content="{DynamicResource SaverWindows}" Click="SaverWindowsClicked" HorizontalAlignment="Left"/>
                        </StackPanel></Border>
                        <TextBlock x:Name="SaverStatus" TextWrapping="Wrap" Foreground="#65776F" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel></TabItem>
                    <TabItem x:Name="PreferencesPage" Header="{DynamicResource PreferencesPageTitle}"><StackPanel TextElement.Foreground="#243C33">
                        <TextBlock Text="{DynamicResource PreferencesHeading}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{DynamicResource PreferencesIntro}" Style="{StaticResource Description}" Margin="0,0,0,16"/>
        <TextBlock Text="{DynamicResource Appearance}" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <ComboBox x:Name="StylePicker" Height="34" Margin="0,0,0,8" SelectionChanged="StyleChanged" AutomationProperties.Name="{DynamicResource Appearance}">
            <ComboBoxItem Content="{DynamicResource RealisticStyle}"/>
            <ComboBoxItem Content="{DynamicResource CuteStyle}"/>
        </ComboBox>
        <TextBlock Text="{DynamicResource StyleHelp}" TextWrapping="Wrap" Foreground="#63776C" Margin="0,0,0,10"/>
        <Border Background="White" BorderBrush="#D5E0D9" BorderThickness="1" CornerRadius="10" Padding="10">
            <Expander x:Name="ScreenInfoExpander" IsExpanded="False">
                <Expander.Header><StackPanel Orientation="Horizontal"><TextBlock Text="{DynamicResource Layout}" FontWeight="SemiBold"/><TextBlock x:Name="DisplaySummary" Margin="14,0,0,0" Foreground="#63776C"/></StackPanel></Expander.Header>
            <StackPanel>
                <Canvas x:Name="DisplayMap" Height="65" Margin="0,14,0,10" SizeChanged="MapSizeChanged"
                    ClipToBounds="True" AutomationProperties.Name="{DynamicResource LayoutName}"/>
                <TextBlock Text="{DynamicResource LayoutHelp}" TextWrapping="Wrap" FontSize="12" Foreground="#63776C"/>
            </StackPanel>
            </Expander>
        </Border>
        <Border Background="White" BorderBrush="#D5E0D9" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,8,0,0">
<Expander Header="{DynamicResource Hotkeys}" IsExpanded="False"><StackPanel>
<TextBlock Text="{DynamicResource KeyHelp}" TextWrapping="Wrap" FontSize="12" Foreground="#63776C" Margin="0,6,0,10"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Label Content="{DynamicResource Start}" Target="{Binding ElementName=StartKey}" VerticalAlignment="Center"/>
<TextBox x:Name="StartKey" Grid.Column="1" FontSize="13" IsReadOnly="True" PreviewKeyDown="CaptureKey" GotKeyboardFocus="KeyFocus" LostKeyboardFocus="KeyBlur" AutomationProperties.Name="{DynamicResource Start}"/></Grid>
<Grid Margin="0,8,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Label Content="{DynamicResource Stop}" Target="{Binding ElementName=PauseKey}" VerticalAlignment="Center"/>
<TextBox x:Name="PauseKey" Grid.Column="1" FontSize="13" IsReadOnly="True" PreviewKeyDown="CaptureKey" GotKeyboardFocus="KeyFocus" LostKeyboardFocus="KeyBlur" AutomationProperties.Name="{DynamicResource Stop}"/></Grid>
<Button x:Name="SaveKeysButton" Content="{DynamicResource SaveKeys}" Click="SaveKeysClicked" HorizontalAlignment="Right"/>
</StackPanel></Expander></Border>
<Border Background="White" BorderBrush="#D5E0D9" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,8,0,0"><Expander Header="{DynamicResource CaptureSection}" IsExpanded="False"><StackPanel>
<CheckBox x:Name="CaptureToggle" Checked="CaptureChanged" Unchecked="CaptureChanged"><TextBlock Text="{DynamicResource CaptureToggle}" TextWrapping="Wrap"/></CheckBox>
<TextBlock Text="{DynamicResource CaptureHelp}" TextWrapping="Wrap" FontSize="12" Foreground="#63776C" Margin="0,8,0,0"/>
</StackPanel></Expander></Border>

                    </StackPanel></TabItem>
                </TabControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
