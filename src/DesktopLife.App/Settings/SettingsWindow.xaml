<Window x:Class="DesktopLife.App.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Icon="/DesktopLife;component/Assets/DesktopLife.ico" Title="{DynamicResource Title}" Width="540" Height="760" MinWidth="470" MinHeight="480"
    WindowStartupLocation="CenterScreen" Background="#F0F4F1" Foreground="#243C33"
    FontFamily="Microsoft YaHei UI" FontSize="12">
    <Window.Resources>
        <Style TargetType="Expander">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#E7EFE9"/>
            <Setter Property="Foreground" Value="#243C33"/>
            <Setter Property="BorderBrush" Value="#CBD9D0"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.85"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.65"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#85BFA2"/><Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="BorderBrush" Value="#D5E0D9"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                <Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="#306951"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="18,0,18,12">
            <Button x:Name="PauseButton" Content="{DynamicResource Pause}" Click="PauseClicked" DockPanel.Dock="Left"/>
            <Button x:Name="ApplyButton" Content="{DynamicResource Apply}" Click="ApplyClicked" IsDefault="True" DockPanel.Dock="Right" Background="#306951" Foreground="White" BorderBrush="#306951"/>
        </DockPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="18,14,18,6">
        <DockPanel LastChildFill="True"><ComboBox x:Name="LanguagePicker" DockPanel.Dock="Right" Width="116" VerticalAlignment="Center" SelectionChanged="LanguageChanged" AutomationProperties.Name="{DynamicResource Language}"><ComboBoxItem Content="简体中文" Tag="zh-CN"/><ComboBoxItem Content="English" Tag="en-US"/></ComboBox><TextBlock Text="DesktopLife" FontFamily="Segoe UI Semibold" FontSize="23"/></DockPanel>
        <TextBlock Text="{DynamicResource Subtitle}" Foreground="#63776C" Margin="0,4,0,18"/>
        <TextBlock Text="{DynamicResource Appearance}" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <ComboBox x:Name="StylePicker" Height="34" Margin="0,0,0,8" SelectionChanged="StyleChanged" AutomationProperties.Name="{DynamicResource Appearance}">
            <ComboBoxItem Content="{DynamicResource RealisticStyle}"/>
            <ComboBoxItem Content="{DynamicResource CuteStyle}"/>
        </ComboBox>
        <TextBlock Text="{DynamicResource StyleHelp}" TextWrapping="Wrap" Foreground="#63776C" Margin="0,0,0,10"/>
        <Border Background="White" BorderBrush="#D5E0D9" BorderThickness="1" CornerRadius="10" Padding="10">
            <Expander x:Name="ScreenInfoExpander" IsExpanded="False">
                <Expander.Header><StackPanel Orientation="Horizontal"><TextBlock Text="{DynamicResource Layout}" FontWeight="SemiBold"/><TextBlock x:Name="DisplaySummary" Margin="14,0,0,0" Foreground="#63776C"/></StackPanel></Expander.Header>
            <StackPanel>
                <Canvas x:Name="DisplayMap" Height="65" Margin="0,14,0,10" SizeChanged="MapSizeChanged"
                    ClipToBounds="True" AutomationProperties.Name="{DynamicResource LayoutName}"/>
                <TextBlock Text="{DynamicResource LayoutHelp}" TextWrapping="Wrap" FontSize="12" Foreground="#63776C"/>
            </StackPanel>
            </Expander>
        </Border>
        <TextBlock Text="{DynamicResource Counts}" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,4"/>
        <TextBlock Text="{DynamicResource CountHelp}" TextWrapping="Wrap" Foreground="#63776C" FontSize="12" Margin="0,0,0,12"/>
        <Border Background="White" BorderBrush="#D5E0D9" BorderThickness="1" CornerRadius="10" Padding="10">
            <StackPanel>
                <TextBlock Text="{DynamicResource Fly}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource FlyHelp}" FontSize="12" TextWrapping="Wrap" Foreground="#63776C" Margin="0,4,0,8"/>                <Border Height="1" Background="#E5ECE7" Margin="0,9,0,6"/>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="84"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center"><Label Content="{DynamicResource Roach}" Target="{Binding ElementName=RoachCount}" Padding="0" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource RoachHelp}" FontSize="12" TextWrapping="Wrap" Foreground="#63776C"/></StackPanel>
                    <TextBox x:Name="RoachCount" Grid.Column="1" MaxLength="6" Text="20" AutomationProperties.Name="{DynamicResource RoachCountName}"/>
                    <TextBlock Grid.Column="2" Text="{DynamicResource Unit}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
                <Slider x:Name="RoachSlider" Minimum="0" Maximum="500" Value="20" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,6,0,0" ValueChanged="RoachSliderChanged" AutomationProperties.Name="{DynamicResource RoachSliderName}"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                    <TextBlock Text="{DynamicResource MinSize}" VerticalAlignment="Center"/>
                    <TextBox x:Name="RoachMin" Width="52" MaxLength="3" Margin="6,0,12,0" AutomationProperties.Name="{DynamicResource MinSize}"/>
                    <TextBlock Text="{DynamicResource MaxSize}" VerticalAlignment="Center"/>
                    <TextBox x:Name="RoachMax" Width="52" MaxLength="3" Margin="6,0,0,0" AutomationProperties.Name="{DynamicResource MaxSize}"/>
                </StackPanel>
                <Border Height="1" Background="#E5ECE7" Margin="0,9,0,6"/>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="84"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center"><Label Content="{DynamicResource Ant}" Target="{Binding ElementName=AntCount}" Padding="0" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource AntHelp}" FontSize="12" TextWrapping="Wrap" Foreground="#63776C"/></StackPanel>
                    <TextBox x:Name="AntCount" Grid.Column="1" MaxLength="6" Text="20" AutomationProperties.Name="{DynamicResource AntCountName}"/>
                    <TextBlock Grid.Column="2" Text="{DynamicResource Unit}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
                <Slider x:Name="AntSlider" Minimum="0" Maximum="500" Value="20" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,6,0,0" ValueChanged="AntSliderChanged" AutomationProperties.Name="{DynamicResource AntSliderName}"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                    <TextBlock Text="{DynamicResource MinSize}" VerticalAlignment="Center"/>
                    <TextBox x:Name="AntMin" Width="52" MaxLength="3" Margin="6,0,12,0" AutomationProperties.Name="{DynamicResource MinSize}"/>
                    <TextBlock Text="{DynamicResource MaxSize}" VerticalAlignment="Center"/>
                    <TextBox x:Name="AntMax" Width="52" MaxLength="3" Margin="6,0,0,0" AutomationProperties.Name="{DynamicResource MaxSize}"/>
                </StackPanel>
                <Border Height="1" Background="#E5ECE7" Margin="0,9,0,6"/>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="84"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center"><Label Content="{DynamicResource Caterpillar}" Target="{Binding ElementName=CaterpillarCount}" Padding="0" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource CaterpillarHelp}" FontSize="12" TextWrapping="Wrap" Foreground="#63776C"/></StackPanel>
                    <TextBox x:Name="CaterpillarCount" Grid.Column="1" MaxLength="6" Text="3" AutomationProperties.Name="{DynamicResource CaterpillarCountName}"/>
                    <TextBlock Grid.Column="2" Text="{DynamicResource Unit}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
                <Slider x:Name="CaterpillarSlider" Minimum="0" Maximum="100" Value="3" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,6,0,0" ValueChanged="CaterpillarSliderChanged" AutomationProperties.Name="{DynamicResource CaterpillarSliderName}"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                    <TextBlock Text="{DynamicResource MinSize}" VerticalAlignment="Center"/>
                    <TextBox x:Name="CaterpillarMin" Width="52" MaxLength="3" Margin="6,0,12,0" AutomationProperties.Name="{DynamicResource MinSize}"/>
                    <TextBlock Text="{DynamicResource MaxSize}" VerticalAlignment="Center"/>
                    <TextBox x:Name="CaterpillarMax" Width="52" MaxLength="3" Margin="6,0,0,0" AutomationProperties.Name="{DynamicResource MaxSize}"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Background="White" BorderBrush="#D5E0D9" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,8,0,0">
<Expander Header="{DynamicResource Hotkeys}" IsExpanded="False"><StackPanel>
<TextBlock Text="{DynamicResource KeyHelp}" TextWrapping="Wrap" FontSize="12" Foreground="#63776C" Margin="0,6,0,10"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Label Content="{DynamicResource Start}" Target="{Binding ElementName=StartKey}" VerticalAlignment="Center"/>
<TextBox x:Name="StartKey" Grid.Column="1" FontSize="13" IsReadOnly="True" PreviewKeyDown="CaptureKey" GotKeyboardFocus="KeyFocus" LostKeyboardFocus="KeyBlur" AutomationProperties.Name="{DynamicResource Start}"/></Grid>
<Grid Margin="0,8,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Label Content="{DynamicResource Stop}" Target="{Binding ElementName=PauseKey}" VerticalAlignment="Center"/>
<TextBox x:Name="PauseKey" Grid.Column="1" FontSize="13" IsReadOnly="True" PreviewKeyDown="CaptureKey" GotKeyboardFocus="KeyFocus" LostKeyboardFocus="KeyBlur" AutomationProperties.Name="{DynamicResource Stop}"/></Grid>
<Button x:Name="SaveKeysButton" Content="{DynamicResource SaveKeys}" Click="SaveKeysClicked" HorizontalAlignment="Right"/>
</StackPanel></Expander></Border>
<Border Background="White" BorderBrush="#D5E0D9" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,8,0,0"><Expander Header="{DynamicResource CaptureSection}" IsExpanded="False"><StackPanel>
<CheckBox x:Name="CaptureToggle" Checked="CaptureChanged" Unchecked="CaptureChanged"><TextBlock Text="{DynamicResource CaptureToggle}" TextWrapping="Wrap"/></CheckBox>
<TextBlock Text="{DynamicResource CaptureHelp}" TextWrapping="Wrap" FontSize="12" Foreground="#63776C" Margin="0,8,0,0"/>
</StackPanel></Expander></Border>
<TextBlock x:Name="Status" Text="{DynamicResource Hint}" TextWrapping="Wrap" Foreground="#63776C" Margin="0,14,0,14" FontSize="12" MinHeight="32" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
    </ScrollViewer>
    </DockPanel>
</Window>
