<Window x:Class="DesktopLife.App.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DesktopLife · 数量设置" Width="540" Height="760" MinWidth="470" MinHeight="600"
    WindowStartupLocation="CenterScreen" Background="#F3F6FA" Foreground="#17324D"
    FontFamily="Microsoft YaHei UI" FontSize="14">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="#D6E0EA"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="26,0,26,20">
            <Button x:Name="PauseButton" Content="暂停全部" Click="PauseClicked" DockPanel.Dock="Left"/>
            <Button x:Name="ApplyButton" Content="保存并应用" Click="ApplyClicked" IsDefault="True" DockPanel.Dock="Right" Background="#2563B8" Foreground="White" BorderBrush="#2563B8"/>
        </DockPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="26,22,26,8">
        <TextBlock Text="DesktopLife" FontFamily="Segoe UI Semibold" FontSize="29"/>
        <TextBlock Text="让生物在整个桌面自由活动" Foreground="#596B7D" Margin="0,4,0,18"/>
        <Border Background="White" BorderBrush="#D6E0EA" BorderThickness="1" CornerRadius="10" Padding="16">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="屏幕排列" FontWeight="SemiBold"/>
                    <TextBlock x:Name="DisplaySummary" HorizontalAlignment="Right" Foreground="#596B7D"/>
                </DockPanel>
                <Canvas x:Name="DisplayMap" Height="112" Margin="0,14,0,10" SizeChanged="MapSizeChanged"
                    ClipToBounds="True" AutomationProperties.Name="已识别的屏幕排列"/>
                <TextBlock Text="相接边缘可跨屏移动，方向跟随 Windows 显示设置。" TextWrapping="Wrap" FontSize="12" Foreground="#596B7D"/>
            </StackPanel>
        </Border>
        <TextBlock Text="全桌面总数量" FontSize="18" FontWeight="SemiBold" Margin="0,22,0,4"/>
        <TextBlock Text="所有屏幕共享这些生物，增加屏幕不会增加数量。" TextWrapping="Wrap" Foreground="#596B7D" FontSize="12" Margin="0,0,0,12"/>
        <Border Background="White" BorderBrush="#D6E0EA" BorderThickness="1" CornerRadius="10" Padding="16">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="84"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center"><Label Content="苍蝇" Target="{Binding ElementName=FlyCount}" Padding="0" FontWeight="SemiBold"/><TextBlock Text="持续绕飞 · 点击停落 3 秒 · 0–20" FontSize="12" Foreground="#596B7D"/></StackPanel>
                    <TextBox x:Name="FlyCount" Grid.Column="1" MaxLength="6" Text="1" AutomationProperties.Name="苍蝇总数量"/>
                    <TextBlock Grid.Column="2" Text="只" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
                <Slider x:Name="FlySlider" Minimum="0" Maximum="20" Value="1" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,12,0,18" ValueChanged="FlySliderChanged" AutomationProperties.Name="苍蝇数量滑块"/>
                <Separator Background="#D6E0EA"/>
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="84"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center"><Label Content="蟑螂" Target="{Binding ElementName=RoachCount}" Padding="0" FontWeight="SemiBold"/><TextBlock Text="爬行与躲避鼠标 · 0–500" FontSize="12" Foreground="#596B7D"/></StackPanel>
                    <TextBox x:Name="RoachCount" Grid.Column="1" MaxLength="6" Text="20" AutomationProperties.Name="蟑螂总数量"/>
                    <TextBlock Grid.Column="2" Text="只" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
                <Slider x:Name="RoachSlider" Minimum="0" Maximum="500" Value="20" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,12,0,0" ValueChanged="RoachSliderChanged" AutomationProperties.Name="蟑螂数量滑块"/>
            </StackPanel>
        </Border>
        <TextBlock x:Name="Status" Text="设为 0 可关闭该物种。关闭窗口后，生物会继续运行。" TextWrapping="Wrap" Foreground="#596B7D" Margin="0,14,0,14" FontSize="12" MinHeight="32" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
    </ScrollViewer>
    </DockPanel>
</Window>
